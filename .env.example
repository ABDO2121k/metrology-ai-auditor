# =============================================================================
# Process Instruments — Metrology Platform
# =============================================================================
# Copy this file to .env before starting the stack:
#
#     cp .env.example .env
#
# Values below are the ones docker compose expects. Hostnames are the compose
# SERVICE NAMES (postgres, redis, minio, ...) because containers resolve each
# other by service name on the metrology-net bridge. Using localhost here is
# the classic mistake: it makes every container try to reach itself.
#
# To run a service directly on the host instead of in a container, swap that
# service's hostname for localhost — see "Running outside Docker" at the end.
# =============================================================================

# -----------------------------------------------------------------------------
# Service ports (as published on the host)
# -----------------------------------------------------------------------------
PORT_GATEWAY=8000
PORT_DOCUMENT=8001
PORT_OCR=8002
PORT_METROLOGY=8003
PORT_ANOMALY=8004
PORT_REPORTING=8005
PORT_FRONTEND=3000

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_DB=metrology_db
POSTGRES_USER=metrology_admin
POSTGRES_PASSWORD=SecretPassword123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://metrology_admin:SecretPassword123!@postgres:5432/metrology_db?sslmode=disable

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisSecret123!
REDIS_URL=redis://:RedisSecret123!@redis:6379/0

# -----------------------------------------------------------------------------
# MinIO S3 object storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioSecretPassword123!
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=MinioSecretPassword123!
MINIO_BUCKET=metrology-certificates
MINIO_BUCKET_CERTIFICATES=metrology-certificates
MINIO_BUCKET_REPORTS=audit-reports
# Used by the OCR service to download a PDF, and by the gateway to probe MinIO.
MINIO_PUBLIC_BASE_URL=http://minio:9000

# -----------------------------------------------------------------------------
# Internal service URLs (gateway -> downstream)
# -----------------------------------------------------------------------------
DOCUMENT_SERVICE_URL=http://document-ingestion:8001
OCR_SERVICE_URL=http://ocr-parsing:8002
METROLOGY_SERVICE_URL=http://metrology-engine:8003
AI_SERVICE_URL=http://ai-anomaly:8004
REPORTING_SERVICE_URL=http://reporting-notification:8005

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# The platform has a SINGLE role: TECHNICIAN, which carries every permission.
# The gateway re-seeds this account on every start, so these credentials always
# work even if the password was changed in the UI.
JWT_SECRET=SuperSecretJwtKey2026ProcessInstruments!
JWT_EXPIRATION_HOURS=24
DEFAULT_ADMIN_USERNAME=fati_sadiki
DEFAULT_ADMIN_PASSWORD=fati2004@

# -----------------------------------------------------------------------------
# OCR extraction
# -----------------------------------------------------------------------------
# Real extraction. Set to true ONLY to serve fixture data while working on the
# UI without a running OCR stack — it returns the same fake certificate for
# every upload.
MOCK_OCR=false

# Pages are rasterised to this longest side (px) before OCR. The sample scans
# are 1768x2500 pt pages: at a fixed 150 dpi they render to 13 MB PNGs, versus
# ~250 KB of JPEG at 2000 px, with no loss of OCR accuracy.
OCR_RENDER_MAX_SIDE=2000
OCR_RENDER_RETRY_MAX_SIDE=3000
OCR_RENDER_JPEG_QUALITY=82

# Pages OCR'd in parallel. ONNX Runtime releases the GIL during inference, so
# this scales close to linearly. Raise it on a machine with more cores; under
# memory pressure a page can fail with "ONNXRuntime inference failed" (the run
# continues and records the reason in diagnostics).
OCR_PAGE_WORKERS=4

# Lines scoring below this are treated as scanner noise.
OCR_MIN_LINE_SCORE=0.45

OCR_DOWNLOAD_TIMEOUT=30
OCR_MAX_PDF_BYTES=62914560

# -----------------------------------------------------------------------------
# Optional vision refinement layer
# -----------------------------------------------------------------------------
# Leave OPENAI_API_KEY EMPTY to run local-only. RapidOCR still reads every
# certificate and header fields come back reliably, but measurement tables are
# reported as INDETERMINE: without column headers the parser cannot tell the
# EMT column from the uncertainty column, and it will not guess.
#
# Set a key and the vision model reads those tables with their column meaning
# intact, cross-checked against the local OCR pass to catch hallucination.
# Cost is roughly $0.01-0.03 per certificate; extraction runs once and is
# stored, so viewing a certificate afterwards is free.
OPENAI_API_KEY=
OCR_VISION_MODEL=gpt-4o
OCR_VISION_TIMEOUT=90
OCR_VISION_MAX_RETRIES=2
OCR_VISION_MAX_TOKENS=16000
OCR_MAX_VISION_PAGES=8

# -----------------------------------------------------------------------------
# ISO 17025 audit thresholds (PR.ECE V9 / NM 2018)
# -----------------------------------------------------------------------------
AUDIT_TEMP_NOMINAL=23.0
AUDIT_TEMP_TOLERANCE=2.0
AUDIT_HUMIDITY_MAX=80.0
# Tolerance when comparing a printed error against the recomputed one.
AUDIT_MATH_TOLERANCE=0.0001
# Max |Correction_retour - Correction_aller| accepted, as a fraction of EMT.
AUDIT_HYSTERESIS_EMT_FRACTION=0.5

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Next.js inlines NEXT_PUBLIC_* at BUILD time, so this is passed as a docker
# build arg. Changing it requires rebuilding web-frontend, not just restarting.
# This one is a browser-facing URL, so it stays localhost (or your host's
# address) rather than a compose service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO

# =============================================================================
# Running outside Docker
# =============================================================================
# To run a service on the host while the infrastructure stays in containers,
# override that service's hostnames with localhost, e.g.:
#
#   POSTGRES_HOST=localhost
#   POSTGRES_DSN=postgres://metrology_admin:SecretPassword123!@localhost:5432/metrology_db?sslmode=disable
#   REDIS_URL=redis://:RedisSecret123!@localhost:6379/0
#   MINIO_ENDPOINT=localhost:9000
#   MINIO_PUBLIC_BASE_URL=http://localhost:9000
#   OCR_SERVICE_URL=http://localhost:8002
# =============================================================================
